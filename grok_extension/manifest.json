{
  "manifest_version": 3,
  "name": "AI 사용량 위젯 - 웹 연결",
  "version": "1.4.0",
  "description": "grok.com, Gemini, ChatGPT 사용량을 주기적으로 읽어 이 PC의 AI 사용량 위젯(127.0.0.1)으로 보냅니다.",
  "permissions": ["alarms", "cookies", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://grok.com/*", "https://gemini.google.com/*", "https://chatgpt.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://gemini.google.com/*"],
    "js": ["usage_page.js"]
  }]
}
